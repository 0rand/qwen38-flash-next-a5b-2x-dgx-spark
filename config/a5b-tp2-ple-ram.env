# ═══════════════════════════════════════════════════════════════════════════════
# Qwen3.8-Flash-Next A5B INT4-AutoRound — 2× DGX Spark (GB10), TP2 + EP
# Profile: PLE TABLE RESIDENT IN RAM — 512K context, GMU 0.55, MTP3
#
# WHY 0.55: the 45.6 GiB PLE table shares the SAME 121 GB unified pool as weights and KV on
# GB10. Measured KV density is 59,650 tokens/GiB, so freeing host RAM costs KV linearly:
#
#     GMU 0.85 -> 3,505,062 KV tok, table 22% cached   (today's default)
#     GMU 0.65 -> 2,053,289 KV tok, table 76% cached
#     GMU 0.58 -> 1,545,168 KV tok, table 94% cached
#     GMU 0.55 -> 1,327,402 KV tok, table 100% cached   <-- this profile
#
# 1.33M tokens still covers a 512K (or 750K) working context with concurrency to spare, and the
# table stops faulting to NVMe entirely. Trade a little KV for zero NVMe gather in the decode path.
#
#   ./ctrl.sh start      # both ranks
#   ./ctrl.sh status
#   ./ctrl.sh stop
#   ./ctrl.sh gates
#
# Use a different profile:  ./ctrl.sh start config/other.env
# ═══════════════════════════════════════════════════════════════════════════════

# ── model ─────────────────────────────────────────────────────────────────────
MODELS_DIR=/var/tmp/models
MODEL_DIR=$MODELS_DIR/Qwen3.8-Flash-Next-125B-A5B-INT4-AutoRound-tp2safe
DRAFT_DIR=$MODELS_DIR/Qwen3.8-Flash-Next-125B-A5B-INT4-AutoRound-tp2safe-draft-k10
TABLE_DIR=$MODEL_DIR/ple-table
SERVED_NAME=qwen3.8-flash-next-a5b
IMAGE=qwen38-flash-dgx:a5b-int4
CONTAINER=qwen38-flash-tp2
PORT=8100

# ── fabric (RoCE): each node uses its OWN address for VLLM_HOST_IP ────────────
HEAD_ROCE_IP=<HEAD_ROCE_IP>
WORKER_ROCE_IP=<WORKER_ROCE_IP>

# ── parallelism ───────────────────────────────────────────────────────────────
# EP IS REQUIRED, for two independent reasons (both measured 2026-09-11):
#   1. Marlin vs WNA16.  Without EP, every routed-expert layer fails the Marlin shape check
#      (640/2 = 320, and 320 % group_size 128 != 0) and falls back to WNA16: ~2x SLOWER decode
#      (17.7-21.8 vs 43.4-45.3 t/s at c1). Prefill is unaffected.
#   2. It is also what lets MTP load without a code patch (see PATTERN notes below).
TP_SIZE=2
EXTRA_ARGS=--enable-expert-parallel

# ── context: 512K ─────────────────────────────────────────────────────────────
# 524288 = 262144 native × 2  ->  YaRN factor 2.0
# ALLOW_LONG=1 is mandatory: without VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 vLLM refuses any
# max_model_len above the checkpoint's derived 262144, regardless of --hf-overrides.
CTX=524288
ALLOW_LONG=1
ROPE='{"max_position_embeddings":524288,"rope_scaling":{"rope_type":"yarn","factor":2.0,"original_max_position_embeddings":262144}}'

# ── memory ────────────────────────────────────────────────────────────────────
# EMPTY KV_BYTES = GMU-driven KV sizing. Measured at 0.85: 58.76 GiB -> 3,505,062 tokens.
# Expect ~1.3M tokens here. Verify from the boot log: "GPU KV cache size: N tokens".
GPU_MEM_UTIL=0.55
KV_BYTES=
KV_DTYPE=auto

# ── speculative decoding ──────────────────────────────────────────────────────
MTP=3
BATCHED_TOKENS=8192
SEQS=8

# ── PLE (n-gram) table: 49 GB on NVMe, read by file-backed mmap ───────────────
# The mmap stays — it simply stops faulting to NVMe, because at this GMU the page cache can
# hold the whole table. Do NOT copy it to tmpfs: that would consume the same unified memory
# for no benefit.
#
# VERIFY after boot (this is the whole point of the profile):
#   grep Cached /proc/meminfo                      # expect ~45+ GiB
#   docker logs ... | grep 'PLE mmap stats'        # gather ms/op should fall from 31-280
#
# CAVEAT: the checkpoint load streams 127 GB through page cache and can evict table pages.
# PREWARM=1 runs at engine start; if the table looks cold afterwards, re-touch it post-boot
# (or mlock it — the container already runs --ulimit memlock=-1 for RDMA).
# PREFETCH remains a complementary lever for a partially cached table; with full residency
# it matters much less.
PLE_PREFETCH=0
PLE_PREFETCH=0
PLE_WORKERS=32
PLE_FAST_ROWS=512

# ── engine knobs ──────────────────────────────────────────────────────────────
FP8_HYBRID=1
SHM=16g

# ── optional engine patch (default OFF) ───────────────────────────────────────
# QPATCH=1 mounts patch/gptq-moe/auto_gptq.py, which makes '-:<regex>' dynamic exclusions
# outrank the automatic Marlin->WNA16 fallback. It lets MTP LOAD without EP, but EP is still
# required for speed (see above), so leave this off unless debugging.
QPATCH=0
