# ═══════════════════════════════════════════════════════════════════════════════
# Qwen3.8-Flash-Next A5B INT4-AutoRound — 2× DGX Spark (GB10), TP2 + EP
# Production profile: 512K context, GMU 0.83, MTP3
#
#   ./ctrl.sh start      # both ranks
#   ./ctrl.sh status
#   ./ctrl.sh stop
#   ./ctrl.sh gates
#
# Use a different profile:  ./ctrl.sh start config/other.env
# ═══════════════════════════════════════════════════════════════════════════════

# ── model ─────────────────────────────────────────────────────────────────────
MODELS_DIR=/var/tmp/models
MODEL_DIR=$MODELS_DIR/Qwen3.8-Flash-Next-125B-A5B-INT4-AutoRound-tp2safe
DRAFT_DIR=$MODELS_DIR/Qwen3.8-Flash-Next-125B-A5B-INT4-AutoRound-tp2safe-draft-k10
TABLE_DIR=$MODEL_DIR/ple-table
SERVED_NAME=qwen3.8-flash-next-a5b
IMAGE=qwen38-flash-dgx:a5b-int4
CONTAINER=qwen38-flash-tp2
PORT=8100

# ── fabric (RoCE): each node uses its OWN address for VLLM_HOST_IP ────────────
HEAD_ROCE_IP=<HEAD_ROCE_IP>
WORKER_ROCE_IP=<WORKER_ROCE_IP>

# ── parallelism ───────────────────────────────────────────────────────────────
# EP IS REQUIRED, for two independent reasons (both measured 2026-09-11):
#   1. Marlin vs WNA16.  Without EP, every routed-expert layer fails the Marlin shape check
#      (640/2 = 320, and 320 % group_size 128 != 0) and falls back to WNA16: ~2x SLOWER decode
#      (17.7-21.8 vs 43.4-45.3 t/s at c1). Prefill is unaffected.
#   2. It is also what lets MTP load without a code patch (see PATTERN notes below).
TP_SIZE=2
EXTRA_ARGS=--enable-expert-parallel

# ── context: 512K ─────────────────────────────────────────────────────────────
# 524288 = 262144 native × 2  ->  YaRN factor 2.0
# ALLOW_LONG=1 is mandatory: without VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 vLLM refuses any
# max_model_len above the checkpoint's derived 262144, regardless of --hf-overrides.
CTX=393216
ALLOW_LONG=1
ROPE='{"max_position_embeddings":393216,"rope_scaling":{"rope_type":"yarn","factor":1.5,"original_max_position_embeddings":262144}}'
# NO rope override -- native frequencies. This is the quality-first choice for <=262K work.
ROPE=

# ── memory ────────────────────────────────────────────────────────────────────
# EMPTY KV_BYTES = GMU-driven KV sizing. Measured at 0.85: 58.76 GiB -> 3,505,062 tokens.
# At 0.83 expect slightly less; read "GPU KV cache size" from the boot log.
# NOTE: GB10 has UNIFIED memory — this same 121 GB pool holds weights + KV + host page cache,
# which is why the 49 GB PLE table can never be fully page-cache resident.
# GMU must go TINY when a KV pin is used, or the two levers fight: vLLM would fill the 0.85
# budget with KV and the pin would be meaningless. 0.01 is the launcher's designed value for
# pin mode ("KV_BYTES sets the cache") and is the combination proven in the earlier
# 262144/KV_BYTES=20g run. The GPU then holds exactly weights + pinned KV + overhead, and
# everything else stays with the host for the PLE table.
GPU_MEM_UTIL=0.01
KV_BYTES=16g        # PIN -> ~1.00M tokens (Primo's clawback: RAM sat unused at 12g), ~3.8x @262K
KV_DTYPE=auto

# ── speculative decoding ──────────────────────────────────────────────────────
MTP=3
BATCHED_TOKENS=8192
SEQS=8

# ── PLE (n-gram) table: 49 GB on NVMe, read by file-backed mmap ───────────────
# The mmap IS the offload path — there is no separate "SSD offload" to disable. At GMU 0.83
# only ~21 GB of the shared pool is left for page cache, so part of every gather comes off
# NVMe (~31-280 ms/op, historically serialised into decode). PREFETCH is the designed
# mitigation and is OFF by default in the image: it hashes n-grams at batch-assembly time
# and overlaps the gather with decode. Enable it to test.
PLE_PREFETCH=0
PLE_WORKERS=32
PLE_FAST_ROWS=512

# ── engine knobs ──────────────────────────────────────────────────────────────
FP8_HYBRID=1
SHM=16g

# ── optional engine patch (default OFF) ───────────────────────────────────────
# QPATCH=1 mounts patch/gptq-moe/auto_gptq.py, which makes '-:<regex>' dynamic exclusions
# outrank the automatic Marlin->WNA16 fallback. It lets MTP LOAD without EP, but EP is still
# required for speed (see above), so leave this off unless debugging.
QPATCH=0
